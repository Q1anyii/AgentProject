# ============================================================
# Mitta AI 智能助理 — 环境变量配置模板
# 使用方法：复制本文件为 .env，然后填写实际值
#   cp .env.example .env
# 通过 python-dotenv 加载，含 API 密钥，请勿提交到版本库
# ============================================================

# ---------------- 腾讯混元大模型配置（主模型，必填） ----------------
# init.py 中 model 和 selector_llm 实际使用的模型提供商
# 主模型：deepseek-v4-flash（对话生成）
# 筛选模型：hy-mt2-plus（工具语义筛选）
HUNYUAN_API_KEY=your_hunyuan_api_key_here

# ---------------- DeepSeek 大模型配置（备用） ----------------
# DeepSeek 平台 API 密钥【必填，敏感信息】
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 模型名称（provider:model 格式）
MODEL_NAME=deepseek:deepseek-v4-flash

# DeepSeek OpenAI 兼容接口地址
BASE_URL=https://api.deepseek.com

# ---------------- Kimi (Moonshot) 大模型配置（备用） ----------------
# Kimi 平台 API 密钥【可选，敏感信息】
KIMI_API_KEY=your_kimi_api_key_here

# Kimi 模型名称
KIMI_MODEL_NAME=kimi-k2.7-code

# Kimi OpenAI 兼容接口地址
KIMI_BASE_URL=https://api.moonshot.cn/v1

# ---------------- SiliconFlow（硅基流动）配置（必填） ----------------
# 用于 Embedding（BAAI/bge-m3）和在线重排（BAAI/bge-reranker-v2-m3）
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 硅基流动平台 API 密钥【必填，敏感信息】
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# ---------------- PostgreSQL 数据库配置（必填） ----------------
# LangGraph Checkpointer（短期记忆/会话状态）+ Store（长期记忆/用户档案）
# 格式：postgresql://user:password@host:port/dbname?sslmode=disable
POSTGRESQL_DB_URL=postgresql://your_username:your_password@localhost:5432/agentproject?sslmode=disable

# ---------------- MySQL 数据库配置（必填） ----------------
# 用户登录/注册（userInfo 表）+ 用户扩展信息（user_profile 表）+ 上传文件（user_files 表）
# 格式：mysql+pymysql://user:password@host:port/dbname
MYSQL_DB_URL=mysql+pymysql://your_username:your_password@127.0.0.1:3306/mitta

# ---------------- Redis 缓存配置（必填） ----------------
# 节点级缓存（检索/工具/记忆）+ 检索缓存 LSH + JWT 登录态 + 限流计数
# 格式：redis://:password@host:port（无密码则为 redis://host:port）
REDIS_DB_URL=redis://localhost:6379

# ---------------- JWT 认证配置（必填） ----------------
# JWT 签名密钥【必填，敏感信息，生产环境务必使用随机强密钥】
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here

# JWT 签名算法（默认 HS256）
JWT_ALGORITHM=HS256

# access token 有效期（分钟）：建议 15~1440，过期后由后端自动续签
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# refresh token 有效期（天）：仅存 Redis 不下发前端，必须大于 access 有效期
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------------- LangSmith 可观测性配置（可选） ----------------
# 是否开启 LangSmith 链路追踪（true/false）
LANGSMITH_TRACING=false

# LangSmith WebUI 服务地址
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# LangSmith API 密钥【可选，敏感信息】
LANGSMITH_API_KEY=your_langsmith_api_key_here

# 追踪数据在 LangSmith WebUI 中显示的项目名
LANGSMITH_PROJECT=AgentProject

# ---------------- MCP 服务器配置 ----------------
# MCP 配置已改为从本地 JSON 文件读取，不再通过此环境变量配置。
# 默认配置文件：resources/config/mcp_servers.json
# 可在前端"系统设置"中指定配置文件路径，或通过 /api/mcp/config 接口修改。
# 修改 MCP 配置后需重启后端服务生效。
# MCP_SERVERS=[{"name":"filesystem","type":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","E:/path"]}]
