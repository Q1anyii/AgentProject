# ============================================================
# AgentProject 环境变量配置模板
# 使用方法：复制本文件为 .env，然后填写实际值
# 通过 python-dotenv 加载，含 API 密钥，请勿提交到版本库
# ============================================================

# ---------------- DeepSeek 大模型配置 ----------------
# DeepSeek 平台 API 密钥（身份认证）【必填，敏感信息】
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 模型名称（provider:model 格式，兼容 Ollama 风格调用）
MODEL_NAME=deepseek:deepseek-v4-flash

# DeepSeek OpenAI 兼容接口地址
BASE_URL=https://api.deepseek.com

# ---------------- 腾讯混元大模型配置 ----------------
# 腾讯混元 API 密钥（init.py 中实际使用的模型）【必填，敏感信息】
HUNYUAN_API_KEY=your_hunyuan_api_key_here

# ---------------- Kimi (Moonshot) 大模型配置 ----------------
# Kimi 平台 API 密钥【可选，敏感信息】
KIMI_API_KEY=your_kimi_api_key_here

# Kimi 模型名称
KIMI_MODEL_NAME=kimi-k2.7-code

# Kimi OpenAI 兼容接口地址
KIMI_BASE_URL=https://api.moonshot.cn/v1

# ---------------- LangSmith 可观测性配置 ----------------
# 是否开启 LangSmith 链路追踪（true/false）
LANGSMITH_TRACING=true

# LangSmith WebUI 服务地址
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# LangSmith API 密钥（用于上报追踪数据）【可选，敏感信息】
LANGSMITH_API_KEY=your_langsmith_api_key_here

# 追踪数据在 LangSmith WebUI 中显示的项目名
LANGSMITH_PROJECT=AgentProject

# ---------------- SiliconFlow（硅基流动）配置 ----------------
# 硅基流动 OpenAI 兼容接口地址（用于 Embedding + 在线重排）
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 硅基流动平台 API 密钥【必填，敏感信息】
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# ---------------- PostgreSQL 数据库配置 ----------------
# PostgreSQL 连接串（LangGraph Checkpointer/Store 用，短期记忆+长期记忆）
# 格式：postgresql://user:password@host:port/dbname?sslmode=disable
POSTGRESQL_DB_URL=postgresql://your_username:your_password@localhost:5432/agentproject?sslmode=disable

# ---------------- MySQL 数据库配置 ----------------
# MySQL 连接串（用户登录/注册用，用户表 userInfo）
# 格式：mysql+pymysql://user:password@host:port/dbname
MYSQL_DB_URL=mysql+pymysql://your_username:your_password@127.0.0.1:3306/mitta

# ---------------- Redis 缓存配置 ----------------
# Redis 连接串（检索缓存 + JWT 登录态存储）
# 格式：redis://:password@host:port（无密码则为 redis://host:port）
REDIS_DB_URL=redis://localhost:6380

# ---------------- JWT 认证配置 ----------------
# JWT 签名密钥（用于签发/验证 access token 和 refresh token）【必填，敏感信息，生产环境务必使用随机强密钥】
JWT_SECRET_KEY=your_jwt_secret_key_here

# JWT 签名算法（默认 HS256）
JWT_ALGORITHM=HS256

# access token 有效期（分钟）：建议 15~1440，越短越安全（过期后由后端自动续签）
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# refresh token 有效期（天）：仅存 Redis 不下发前端，access 过期时后端自动续签；
# 必须大于 access 有效期，否则续签会失败
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------------- MCP 服务器配置（可选） ----------------
# 外部 MCP 服务器列表（JSON 数组），启动时连接并将工具注入 LangGraph Agent；
# 不配置或配置错误时跳过，不影响应用启动。
# stdio 型：type 可省略（默认 stdio）；cwd 为相对项目根路径时自动转绝对路径
# sse 型：{"type":"sse","name":"xxx","url":"http://host:port/mcp"}
# MCP_SERVERS=[{"name":"agent_server","command":"D:/Develop/conda_envs/langchain1.2/python.exe","args":["server.py"],"cwd":"src/mcp_client/mcp_server"}]
